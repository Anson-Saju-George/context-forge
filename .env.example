# HOST_PORT is the localhost port published by Docker Compose.
# Container internal port is always 8000.
HOST_PORT=8000

APP_ENV=production

# Config file selection. Points at one of config.json / config.v1.json / config.v2.json /
# config.v3.json / config.v3.1.json at the repo root.
CONFIG_FILE=config.json

# Ollama connection.
# Local (default): container reaches host-installed Ollama via host.docker.internal.
# Modal: deploy backend/modal_app.py (`modal deploy backend/modal_app.py`), then set
#   OLLAMA_BASE_URL to the printed https://...modal.direct URL, and set MODAL_PROXY_KEY /
#   MODAL_PROXY_SECRET below (the endpoint requires proxy auth - see modal_app.py).
#   Proxy tokens are created in the Modal dashboard: Workspace settings > Proxy Auth Tokens.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# THE single source of truth for which models the app offers. Comma-separated. The
# frontend shows only models from this list that are ACTUALLY installed on the active
# backend, and Modal (backend/modal_app.py) pulls exactly this list at deploy time -
# so "offered", "installed", and "pulled" can never drift apart. Leave blank to offer
# whatever the backend reports installed. Sizes: qwen3:4b-instruct 2.5 GB (default),
# gemma4:e2b 7.2 GB, gemma4:e4b 9.6 GB, gemma4:26b 17 GB (heavier = slower first Modal pull).
OLLAMA_MODEL_ALLOWLIST=qwen3:4b-instruct,gemma4:e2b,gemma4:e4b

OLLAMA_TIMEOUT_SECONDS=300

# Modal proxy auth headers. Required only when OLLAMA_BASE_URL points at a Modal
# deployment (backend/modal_app.py); ignored for local Ollama.
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# Routing (must match frontend's Vite base path).
FRONTEND_BASE_PATH=/context-forge
API_BASE_URL=
API_PREFIX=/context-forge/api

# Comma-separated list of allowed browser origins. Required in production -
# the checked-in config.json only allows localhost dev origins.
CORS_ORIGINS=https://your-production-domain.example

# Storage.
STORAGE_BASE_DIR=data/chats

# Chat persistence & limits.
# MAX_CHATS_PER_USER   - how many saved conversations a non-admin may keep.
# MAX_PROMPTS_PER_CHAT - how many user prompts a single conversation allows.
# CHAT_RETENTION_DAYS  - inactive chats (and their uploaded docs) are purged after this
#                        many days with no activity. Admins are exempt from the count limits.
MAX_CHATS_PER_USER=5
MAX_PROMPTS_PER_CHAT=10
CHAT_RETENTION_DAYS=30

# Local job controls.
MAX_ACTIVE_CLIENTS=1
MAX_UPLOAD_FILES=5
VRAM_AVAILABLE_GB=0
VRAM_REQUIRED_GB=0

# Auth & access window.
# AUTH_SESSION_SECONDS is the single source of truth for the paid/free access window.
# The "30 min" / "1 hour" labels on the pay button and Razorpay order are derived from
# it automatically - do not hardcode a duration anywhere. 1800 = 30 min, 3600 = 1 hour.
AUTH_SESSION_SECONDS=3600
# First-time users get one free access window. Set to false to require payment upfront.
FREE_TRIAL_ENABLED=true
ADMIN_EMAILS=admin@example.com
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=

# Payments.
# RAZORPAY_AMOUNT_PAISE is the single source of truth for the price (in paise; 4900 = Rs49).
# The pay button and order description derive their amount label from it.
# Use rzp_test_ keys while testing so charges are not real; swap to rzp_live_ for production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_AMOUNT_PAISE=4900
RAZORPAY_CURRENCY=INR
